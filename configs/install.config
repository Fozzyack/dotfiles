# Arch Linux; uses pacman with sudo. Commands are one per line for Temperz.
# Run sudo pacman -Syu before installing packages to avoid partial upgrades.
# --noconfirm accepts default package-manager answers; sudo may still request a password.
sudo pacman -S --needed --noconfirm base-devel curl ripgrep unzip git gnupg openssh
curl -fsSL https://bun.com/install | bash
sudo pacman -S --needed --noconfirm fish starship fzf fd bat eza go zig
# Make Fish the current user's default login shell; log out and back in afterward.
test "$(getent passwd "$(id -un)" | cut -d: -f7)" = /usr/bin/fish || sudo chsh -s /usr/bin/fish "$(id -un)"
# Fish still calls exa; provide compatibility without replacing an existing command.
command -v exa >/dev/null 2>&1 || sudo ln -s /usr/bin/eza /usr/local/bin/exa
sudo pacman -S --needed --noconfirm neovim
sudo pacman -S --needed --noconfirm nodejs npm python python-pip python-virtualenv dotnet-sdk cmake tree-sitter-cli
sudo pacman -S --needed --noconfirm tmux
sudo pacman -S --needed --noconfirm zellij
sudo pacman -S --needed --noconfirm btop
# ImageMagick is required for Fastfetch's Kitty/Sixel image rendering.
sudo pacman -S --needed --noconfirm fastfetch imagemagick
sudo pacman -S --needed --noconfirm ghostty
# Terminess is used by the configs; include alternative Nerd Fonts and standalone symbols.
sudo pacman -S --needed --noconfirm ttf-terminus-nerd ttf-jetbrains-mono-nerd ttf-firacode-nerd ttf-hack-nerd ttf-nerd-fonts-symbols-mono
sudo pacman -S --needed --noconfirm papirus-icon-theme
curl -fsSL https://opencode.ai/v2/install | bash
sudo pacman -S --needed --noconfirm hyprland
sudo pacman -S --needed --noconfirm hyprpaper
sudo pacman -S --needed --noconfirm dolphin
sudo pacman -S --needed --noconfirm waybar
sudo pacman -S --needed --noconfirm rofi
sudo pacman -S --needed --noconfirm wireplumber pipewire-pulse libpulse pavucontrol alsa-utils alsa-plugins
sudo pacman -S --needed --noconfirm brightnessctl playerctl
sudo pacman -S --needed --noconfirm bluez bluez-utils blueman
sudo pacman -S --needed --noconfirm networkmanager nm-connection-editor
sudo pacman -S --needed --noconfirm python-gobject gtk4 gtk4-layer-shell
# Run the remaining commands after deploying configs/configs to ~/.config.
# Clear host-specific lookup paths without loading the broken startup config.
fish --no-config -c 'set --erase --universal fish_function_path; set --erase --universal fish_complete_path; true'
fish -c 'fisher update'
test -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm" || git clone https://github.com/tmux-plugins/tpm "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"
# In tmux, press prefix + I to install any missing declared plugins.
nvim --headless "+Lazy! sync" +qa
# rzls.nvim is deprecated and rzls is no longer in the configured Mason registries; Razor needs a separate config migration.
# Fish's ~/.local/zig/0.17.0 override is not supplied by Arch's zig package; keep Zig and zls versions compatible.
# Enable NetworkManager/Bluetooth and the PipeWire user services as appropriate for the host; installation does not switch active services.
# Hyprpaper's ~/wallpaper files are not included; supply them or update hyprpaper.conf.
