sudo pacman -S --needed --noconfirm base-devel curl ripgrep unzip zip tar gzip git gnupg openssh
sudo pacman -S --needed --noconfirm xorg-server xorg-xinit xorg-xsetroot xorg-xset mesa i3-wm i3status ghostty fish rofi thunar feh dunst picom ttf-terminus-nerd papirus-icon-theme
sudo pacman -S --needed --noconfirm starship fzf fd bat eza go zig neovim fastfetch imagemagick
sudo pacman -S --needed --noconfirm nodejs npm python python-pip python-virtualenv dotnet-sdk cmake tree-sitter-cli xclip
command -v exa >/dev/null 2>&1 || sudo ln -s /usr/bin/eza /usr/local/bin/exa
sudo pacman -S --needed --noconfirm pipewire pipewire-pulse wireplumber brightnessctl playerctl
sudo pacman -S --needed --noconfirm spice-vdagent
bash -o pipefail -c 'curl -fsSL https://bun.com/install | BUN_INSTALL="$HOME/.bun" SHELL=/bin/false bash'
bash -o pipefail -c 'curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path'
fish --no-config -c 'fish_add_path --universal "$HOME/.opencode/bin"'
bash vm/setup-fish.sh
if test "$(readlink -f "${XDG_CONFIG_HOME:-$HOME/.config}/nvim")" = "$(readlink -f vm/configs/nvim)"; then nvim --headless "+Lazy! sync" "+lua require('FozzyConfig.bootstrap')()" +qa; else echo 'Run Setup VM first; the Neovim config must link to vm/configs/nvim.' >&2; false; fi
