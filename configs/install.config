# Arch Linux; paru must already be installed. Commands are one per line for Temperz.
# --noconfirm accepts default package-manager answers; sudo may still request a password.
paru -S --needed --noconfirm base-devel curl ripgrep unzip git gnupg openssh
curl -fsSL https://bun.com/install | bash
paru -S --needed --noconfirm fish starship fzf fd bat eza go zig
# Make Fish the current user's default login shell; log out and back in afterward.
test "$(getent passwd "$(id -un)" | cut -d: -f7)" = /usr/bin/fish || sudo chsh -s /usr/bin/fish "$(id -un)"
# Fish still calls exa; provide compatibility without replacing an existing command.
command -v exa >/dev/null 2>&1 || sudo ln -s /usr/bin/eza /usr/local/bin/exa
paru -S --needed --noconfirm neovim
paru -S --needed --noconfirm nodejs npm python python-pip python-virtualenv dotnet-sdk cmake tree-sitter-cli
paru -S --needed --noconfirm tmux
paru -S --needed --noconfirm zellij
paru -S --needed --noconfirm btop
paru -S --needed --noconfirm fastfetch
paru -S --needed --noconfirm ghostty
# Terminess is used by the configs; include alternative Nerd Fonts and standalone symbols.
paru -S --needed --noconfirm ttf-terminus-nerd ttf-jetbrains-mono-nerd ttf-firacode-nerd ttf-hack-nerd ttf-nerd-fonts-symbols-mono
paru -S --needed --noconfirm papirus-icon-theme
curl -fsSL https://opencode.ai/v2/install | bash
paru -S --needed --noconfirm hyprland
paru -S --needed --noconfirm hyprpaper
paru -S --needed --noconfirm dolphin
paru -S --needed --noconfirm waybar
paru -S --needed --noconfirm rofi
paru -S --needed --noconfirm wireplumber pipewire-pulse libpulse pavucontrol alsa-utils alsa-plugins
paru -S --needed --noconfirm brightnessctl playerctl
paru -S --needed --noconfirm bluez bluez-utils blueman
paru -S --needed --noconfirm networkmanager nm-connection-editor
paru -S --needed --noconfirm python-gobject gtk4 gtk4-layer-shell
# Run the remaining commands after deploying configs/configs to ~/.config.
fish -c 'fisher update'
test -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm" || git clone https://github.com/tmux-plugins/tpm "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"
# In tmux, press prefix + I to install any missing declared plugins.
nvim --headless "+Lazy! sync" +qa
# rzls.nvim is deprecated and rzls is no longer in the configured Mason registries; Razor needs a separate config migration.
# Fish's ~/.local/zig/0.17.0 override is not supplied by Arch's zig package; keep Zig and zls versions compatible.
# Enable NetworkManager/Bluetooth and the PipeWire user services as appropriate for the host; installation does not switch active services.
# Hyprpaper's ~/wallpaper files are not included; supply them or update hyprpaper.conf.
