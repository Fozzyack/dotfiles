{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Deploy this directory, including render-logo.py and the terminal-sized portrait.
    // Native Ghostty (Kitty) / WezTerm (iTerm) image, selected automatically.
    // tmux needs `set -g allow-passthrough on`.
    // The resized PNG keeps the encoded image below tmux's 1 MiB input-buffer limit.
    "logo": {
        "type": "raw",
        "source": "\"$(python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/render-logo.py\")\"",
        "width": 36,
        "height": 18,
        "position": "left",
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": "  /  ",
        "color": {
            "keys": "#ff851b",
            "title": "#ff9b38",
            "output": "#e8a15b",
            "separator": "#66b2a5"
        },
        "bar": {
            "width": 8,
            "char": {
                "elapsed": "■",
                "total": "·"
            },
            "border": {
                "left": "[",
                "right": "]"
            },
            "color": {
                "elapsed": "#ff851b",
                "total": "#315653",
                "border": "#66b2a5"
            }
        },
        "percent": {
            "type": 2,
            "color": {
                "green": "#ff851b",
                "yellow": "#ff9b38",
                "red": "#cf6b56"
            }
        }
    },
    "modules": [
        {
            "format": "{#title}▐ {#1}{user-name}{#separator} // {#title}{host-name}{#}",
            "type": "title"
        },
        {
            "type": "custom",
            "format": "{#title}▀▀ {#1}S Y S T E M {#separator}─────────────────{#}"
        },
        {
            "key": "OS    ",
            "type": "os"
        },
        {
            "key": "KERNEL",
            "type": "kernel"
        },
        {
            "key": "UPTIME",
            "type": "uptime"
        },
        {
            "key": "WM    ",
            "type": "wm"
        },
        {
            "key": "TERM  ",
            "type": "terminal"
        },
        {
            "key": "SHELL ",
            "type": "shell"
        },
        {
            "type": "custom",
            "format": "{#title}▀▀ {#1}H A R D W A R E {#separator}─────────────{#}"
        },
        {
            "key": "CPU   ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "GPU   ",
            "type": "gpu",
            "format": "{name}"
        },
        {
            "key": "RAM   ",
            "type": "memory",
            "format": "{percentage-bar} {#output}{used} / {total}"
        },
        {
            "key": "DISK  ",
            "type": "disk",
            "folders": "/",
            "format": "{size-percentage-bar} {#output}{size-used} / {size-total}"
        },
        {
            "key": "NET   ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "type": "custom",
            "format": "{#title}▄▄▄▄ {#keys}▄▄▄▄ {#output}▄▄▄▄ {#separator}▄▄▄▄ {##315653}▄▄▄▄{#}"
        }
    ]
}
