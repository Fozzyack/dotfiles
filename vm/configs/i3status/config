general {
    colors = true
    color_good = "#66b2a5"
    color_degraded = "#ff851b"
    color_bad = "#cf6b56"
    interval = 5
}
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"
disk "/" {
    format = "DISK %avail"
}
memory {
    format = "RAM %used / %total"
    threshold_degraded = "10%"
    format_degraded = "RAM %used / %total"
}
load {
    format = "LOAD %1min"
}
tztime local {
    format = "%a %d %b  %H:%M"
}
