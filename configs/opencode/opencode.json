{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "edit" : "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow"
    },
  },
  "mcp": {
      "mobbin-mcp-server": {
          "type": "remote",
          "url": "https://api.mobbin.com/mcp",
          "enabled": true
      },
  },
}
