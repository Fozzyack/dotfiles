/* Floating launcher styled to match the Waybar palette. */

configuration {
    modes: [combi];
    combi-modi: [drun, window, run, ssh];
    display-combi: "";
    icon-theme: "Papirus";
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    background:         #11121AEF;
    surface:            #1A1B26;
    surface-hover:      #292A35;
    accent:             #99D1DB;
    accent-soft:        #99D1DB1A;
    text:               #C6D0F5;
    text-muted:         #838BA7;
    border:             #99D1DB33;

    background-color:   transparent;
    text-color:         @text;
    font:               "Inter 12";

    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    location:           center;
    anchor:             center;
    width:              560px;
    border:             1px;
    border-color:       @border;
    border-radius:      14px;
    background-color:   @background;
}

mainbox {
    padding:            16px;
    spacing:            12px;
}

inputbar {
    padding:            11px 14px;
    spacing:            12px;
    border:             1px;
    border-color:       @border;
    border-radius:      9px;
    background-color:   @surface;
    children:           [prompt, entry];
}

prompt {
    text-color:         @accent;
}

entry {
    placeholder:        "Search apps, windows, and commands";
    placeholder-color:  @text-muted;
    text-color:         @text;
}

message {
    padding:            10px 14px;
    border-radius:      9px;
    background-color:   @surface;
}

textbox {
    text-color:         @text-muted;
}

listview {
    lines:              7;
    columns:            1;
    spacing:            5px;
    fixed-height:       false;
    scrollbar:          false;
    cycle:              true;
    dynamic:            true;
}

element {
    padding:            9px 12px;
    spacing:            12px;
    border-radius:      8px;
    background-color:   transparent;
    children:           [element-icon, element-text];
}

element normal normal,
element alternate normal {
    background-color:   transparent;
    text-color:         @text;
}

element normal active,
element alternate active {
    background-color:   transparent;
    text-color:         @accent;
}

element normal urgent,
element alternate urgent {
    background-color:   transparent;
    text-color:         #E78284;
}

element selected normal,
element selected active,
element selected urgent {
    background-color:   @accent-soft;
    text-color:         @accent;
}

element-icon {
    size:               24px;
    background-color:   transparent;
}

element-text {
    vertical-align:     0.5;
    background-color:   transparent;
    text-color:         inherit;
}
