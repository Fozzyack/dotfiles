# Arch Linux; paru must already be installed. Commands are one per line for Temperz.
paru -S --needed base-devel curl ripgrep unzip git gnupg openssh
curl -fsSL https://bun.com/install | bash
paru -S --needed fish starship fzf fd bat eza go zig
# Fish still calls exa; provide compatibility without replacing an existing command.
command -v exa >/dev/null 2>&1 || sudo ln -s /usr/bin/eza /usr/local/bin/exa
paru -S --needed neovim
paru -S --needed nodejs npm python python-pip python-virtualenv dotnet-sdk cmake tree-sitter-cli
paru -S --needed tmux
paru -S --needed zellij
paru -S --needed btop
paru -S --needed fastfetch
paru -S --needed ghostty
paru -S --needed ttf-terminus-nerd papirus-icon-theme
curl -fsSL https://opencode.ai/v2/install | bash
paru -S --needed hyprland
paru -S --needed hyprpaper
paru -S --needed dolphin
paru -S --needed waybar
paru -S --needed rofi
paru -S --needed wireplumber pipewire-pulse libpulse pavucontrol alsa-utils alsa-plugins
paru -S --needed brightnessctl playerctl
paru -S --needed bluez bluez-utils blueman
paru -S --needed networkmanager nm-connection-editor
paru -S --needed python-gobject gtk4 gtk4-layer-shell
# Run the remaining commands after deploying configs/configs to ~/.config.
fish -c 'fisher update'
test -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm" || git clone https://github.com/tmux-plugins/tpm "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm"
# In tmux, press prefix + I to install any missing declared plugins.
nvim --headless "+Lazy! sync" +qa
nvim --headless "+MasonInstall css-lsp html-lsp lua-language-server marksman cmake-language-server docker-compose-language-service gopls tailwindcss-language-server django-language-server pyright bash-language-server vue-language-server vtsls sqls svelte-language-server clangd zls roslyn prettier autopep8 clang-format csharpier" +qa
# rzls.nvim is deprecated and rzls is no longer in the configured Mason registries; Razor needs a separate config migration.
# Fish's ~/.local/zig/0.17.0 override is not supplied by Arch's zig package; keep Zig and zls versions compatible.
# Enable NetworkManager/Bluetooth and the PipeWire user services as appropriate for the host; installation does not switch active services.
# Hyprpaper's ~/wallpaper files are not included; supply them or update hyprpaper.conf.
